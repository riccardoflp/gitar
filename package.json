{
  "name": "gitardo",
  "displayName": "Gitardo",
  "description": "Commit graph, history and everyday Git operations in a single panel.",
  "version": "0.6.0",
  "publisher": "RiccardoFilippozzi",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": "https://github.com/riccardoflp/gitardo",
  "homepage": "https://github.com/riccardoflp/gitardo#readme",
  "bugs": {
    "url": "https://github.com/riccardoflp/gitardo/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "graph",
    "history",
    "log",
    "blame",
    "branch",
    "commit",
    "rebase",
    "stash",
    "scm"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "gitardo",
          "title": "Gitardo",
          "icon": "media/gitardo.svg"
        }
      ]
    },
    "views": {
      "gitardo": [
        {
          "type": "webview",
          "id": "gitardo.graph",
          "name": "Graph"
        }
      ],
      "scm": [
        {
          "type": "webview",
          "id": "gitardo.changes",
          "name": "Gitardo Changes",
          "contextualTitle": "Gitardo",
          "visibility": "hidden",
          "initialSize": 5
        },
        {
          "type": "webview",
          "id": "gitardo.commits",
          "name": "Commits",
          "contextualTitle": "Gitardo",
          "initialSize": 4
        },
        {
          "type": "webview",
          "id": "gitardo.sideGraph",
          "name": "Gitardo Graph",
          "contextualTitle": "Gitardo",
          "visibility": "collapsed",
          "initialSize": 4
        },
        {
          "type": "webview",
          "id": "gitardo.branches",
          "name": "Branches",
          "contextualTitle": "Gitardo",
          "initialSize": 3
        },
        {
          "type": "webview",
          "id": "gitardo.stashes",
          "name": "Stashes",
          "contextualTitle": "Gitardo",
          "visibility": "collapsed",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "gitardo.openGraph",
        "title": "Show Graph",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.openInEditor",
        "title": "Open Graph in Editor",
        "category": "Gitardo",
        "icon": "$(link-external)"
      },
      {
        "command": "gitardo.showActivity",
        "title": "Show What Is Running",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.refresh",
        "title": "Refresh",
        "category": "Gitardo",
        "icon": "$(refresh)"
      },
      {
        "command": "gitardo.fetch",
        "title": "Fetch",
        "category": "Gitardo",
        "icon": "$(repo-fetch)"
      },
      {
        "command": "gitardo.pull",
        "title": "Pull",
        "category": "Gitardo",
        "icon": "$(repo-pull)"
      },
      {
        "command": "gitardo.pullPlain",
        "title": "Pull (No Options)",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.pullRebase",
        "title": "Pull (Rebase)",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.pullAutostash",
        "title": "Pull (Autostash)",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.pullRebaseAutostash",
        "title": "Pull (Rebase, Autostash)",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.push",
        "title": "Push",
        "category": "Gitardo",
        "icon": "$(repo-push)"
      },
      {
        "command": "gitardo.pushForceWithLease",
        "title": "Push (Force with Lease)",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.pushForce",
        "title": "Push (Force)",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.showLog",
        "title": "Show Command Log",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.openChanges",
        "title": "Show Changes",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.stash",
        "title": "Stash Changes",
        "category": "Gitardo",
        "icon": "$(git-stash)"
      },
      {
        "command": "gitardo.scmStashFile",
        "title": "Stash This File…",
        "category": "Gitardo",
        "icon": "$(git-stash)"
      },
      {
        "command": "gitardo.scmStashStaged",
        "title": "Stash Only the Staged Changes…",
        "category": "Gitardo",
        "icon": "$(git-stash)"
      },
      {
        "command": "gitardo.scmStashAll",
        "title": "Stash All Changes…",
        "category": "Gitardo",
        "icon": "$(git-stash)"
      },
      {
        "command": "gitardo.undo",
        "title": "Undo Last Operation",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.fileHistory",
        "title": "Show File History",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.revealCommit",
        "title": "Show Commit in Graph",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.reflog",
        "title": "Browse Reflog",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.cleanupBranches",
        "title": "Clean Up Branches",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.signInGitHub",
        "title": "Sign In to GitHub",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.toggleBlame",
        "title": "Toggle Inline Blame",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.toggleFileBlame",
        "title": "Toggle File Blame",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.showFileBlame",
        "title": "Show File Blame",
        "category": "Gitardo",
        "icon": "$(person)"
      },
      {
        "command": "gitardo.hideFileBlame",
        "title": "Hide File Blame",
        "category": "Gitardo",
        "icon": "$(eye-closed)"
      },
      {
        "command": "gitardo.toggleBlameEveryFile",
        "title": "Toggle File Blame in Every File",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.blameEveryFile",
        "title": "Keep File Blame On in Every File",
        "category": "Gitardo",
        "icon": "$(pin)"
      },
      {
        "command": "gitardo.blameChosenFiles",
        "title": "Stop Keeping File Blame On in Every File",
        "category": "Gitardo",
        "icon": "$(pinned)"
      },
      {
        "command": "gitardo.toggleBlameWhitespace",
        "title": "Toggle Ignoring Whitespace and Moved Lines in Blame",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.blameIgnoreWhitespace",
        "title": "Ignore Whitespace and Moved Lines in Blame",
        "category": "Gitardo",
        "icon": "$(filter)"
      },
      {
        "command": "gitardo.blameCountWhitespace",
        "title": "Stop Ignoring Whitespace and Moved Lines in Blame",
        "category": "Gitardo",
        "icon": "$(filter-filled)"
      },
      {
        "command": "gitardo.openLineCommit",
        "title": "Open Commit of Current Line in Editor",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.revealLineCommit",
        "title": "Reveal Commit of Current Line in Graph",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.blamePrevious",
        "title": "Blame File Before Commit of Current Line",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.switchIdentity",
        "title": "Switch Identity",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.selectRepository",
        "title": "Select Repository",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.remotes",
        "title": "Manage Remotes",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.bisectReset",
        "title": "End Bisect",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.compare",
        "title": "Compare Branches, Tags or Commits…",
        "category": "Gitardo",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitardo.compareWith",
        "title": "Compare with Branch, Tag or Commit…",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.goToCommit",
        "title": "Go to Commit…",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.openCommit",
        "title": "Open Commit in Editor…",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.resolveConflicts",
        "title": "Resolve Conflicts Automatically",
        "category": "Gitardo",
        "icon": "$(wand)"
      },
      {
        "command": "gitardo.reviewConflicts",
        "title": "Review the Resolutions of the Conflicts",
        "category": "Gitardo",
        "icon": "$(checklist)"
      },
      {
        "command": "gitardo.resolveConflictsWithAI",
        "title": "Resolve Conflicts with AI",
        "category": "Gitardo",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitardo.chooseConflictModel",
        "title": "Choose the Model That Resolves Conflicts",
        "category": "Gitardo",
        "icon": "$(hubot)"
      },
      {
        "command": "gitardo.createBranch",
        "title": "Create Branch…",
        "category": "Gitardo",
        "icon": "$(add)"
      },
      {
        "command": "gitardo.createWorktree",
        "title": "Create Worktree…",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.addSubmodule",
        "title": "Add Submodule…",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.switchWorktree",
        "title": "Switch Worktree…",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.worktreeSetup",
        "title": "Choose What New Worktrees Get…",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.linkIntoWorktrees",
        "title": "Link into New Worktrees",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.copyIntoWorktrees",
        "title": "Copy into New Worktrees",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.stopLinkingIntoWorktrees",
        "title": "Stop Linking into New Worktrees",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.stopCopyingIntoWorktrees",
        "title": "Stop Copying into New Worktrees",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.openCommits",
        "title": "Show Commits in the Side Bar",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.openSideGraph",
        "title": "Open Graph in the Side Bar",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.openBranches",
        "title": "Show Branches",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.openStashes",
        "title": "Show Stashes",
        "category": "Gitardo"
      },
      {
        "command": "gitardo.openInFlowDiff",
        "title": "Open in Flow Diff",
        "category": "Gitardo",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitardo.flowDiff.openInDiffEditor",
        "title": "Open in Diff Editor",
        "category": "Gitardo",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitardo.flowDiff.openFile",
        "title": "Open File",
        "category": "Gitardo",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitardo.flowDiff.previousChange",
        "title": "Previous Change",
        "category": "Gitardo",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitardo.flowDiff.nextChange",
        "title": "Next Change",
        "category": "Gitardo",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitardo.flowDiff.stageFile",
        "title": "Stage File",
        "category": "Gitardo",
        "icon": "$(add)"
      },
      {
        "command": "gitardo.flowDiff.unstageFile",
        "title": "Unstage File",
        "category": "Gitardo",
        "icon": "$(remove)"
      },
      {
        "command": "gitardo.flowDiff.discardFile",
        "title": "Discard Changes",
        "category": "Gitardo",
        "icon": "$(discard)"
      },
      {
        "command": "gitardo.openInFlowMerge",
        "title": "Open in Flow Merge",
        "category": "Gitardo",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitardo.flowMerge.openInMergeEditor",
        "title": "Open in Merge Editor",
        "category": "Gitardo",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitardo.flowMerge.openFile",
        "title": "Open File",
        "category": "Gitardo",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitardo.flowMerge.previousChange",
        "title": "Previous Change",
        "category": "Gitardo",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitardo.flowMerge.nextChange",
        "title": "Next Change",
        "category": "Gitardo",
        "icon": "$(arrow-down)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitardo.linkIntoWorktrees",
          "when": "false"
        },
        {
          "command": "gitardo.copyIntoWorktrees",
          "when": "false"
        },
        {
          "command": "gitardo.stopLinkingIntoWorktrees",
          "when": "false"
        },
        {
          "command": "gitardo.stopCopyingIntoWorktrees",
          "when": "false"
        },
        {
          "command": "gitardo.revealCommit",
          "when": "false"
        },
        {
          "command": "gitardo.resolveConflicts",
          "when": "config.gitardo.conflicts.autoResolve"
        },
        {
          "command": "gitardo.reviewConflicts",
          "when": "config.gitardo.conflicts.autoResolve || config.gitardo.conflicts.ai"
        },
        {
          "command": "gitardo.resolveConflictsWithAI",
          "when": "config.gitardo.conflicts.ai"
        },
        {
          "command": "gitardo.chooseConflictModel",
          "when": "config.gitardo.conflicts.ai"
        },
        {
          "command": "gitardo.showFileBlame",
          "when": "false"
        },
        {
          "command": "gitardo.hideFileBlame",
          "when": "false"
        },
        {
          "command": "gitardo.blameEveryFile",
          "when": "false"
        },
        {
          "command": "gitardo.blameChosenFiles",
          "when": "false"
        },
        {
          "command": "gitardo.blameIgnoreWhitespace",
          "when": "false"
        },
        {
          "command": "gitardo.blameCountWhitespace",
          "when": "false"
        },
        {
          "command": "gitardo.scmStashFile",
          "when": "false"
        },
        {
          "command": "gitardo.scmStashStaged",
          "when": "false"
        },
        {
          "command": "gitardo.scmStashAll",
          "when": "false"
        },
        {
          "command": "gitardo.openInFlowDiff",
          "when": "isInDiffEditor && !isInEmbeddedDiffEditor && resourceScheme =~ /^(file|git|gitardo)$/"
        },
        {
          "command": "gitardo.flowDiff.openInDiffEditor",
          "when": "activeWebviewPanelId == gitardo.flowDiff"
        },
        {
          "command": "gitardo.flowDiff.openFile",
          "when": "activeWebviewPanelId == gitardo.flowDiff"
        },
        {
          "command": "gitardo.flowDiff.previousChange",
          "when": "activeWebviewPanelId == gitardo.flowDiff"
        },
        {
          "command": "gitardo.flowDiff.nextChange",
          "when": "activeWebviewPanelId == gitardo.flowDiff"
        },
        {
          "command": "gitardo.flowDiff.stageFile",
          "when": "activeWebviewPanelId == gitardo.flowDiff"
        },
        {
          "command": "gitardo.flowDiff.unstageFile",
          "when": "activeWebviewPanelId == gitardo.flowDiff"
        },
        {
          "command": "gitardo.flowDiff.discardFile",
          "when": "activeWebviewPanelId == gitardo.flowDiff"
        },
        {
          "command": "gitardo.openInFlowMerge",
          "when": "isMergeEditor || resourceScheme == file && gitardo.hasRepository"
        },
        {
          "command": "gitardo.flowMerge.openInMergeEditor",
          "when": "activeWebviewPanelId == gitardo.flowMerge"
        },
        {
          "command": "gitardo.flowMerge.openFile",
          "when": "activeWebviewPanelId == gitardo.flowMerge"
        },
        {
          "command": "gitardo.flowMerge.previousChange",
          "when": "activeWebviewPanelId == gitardo.flowMerge"
        },
        {
          "command": "gitardo.flowMerge.nextChange",
          "when": "activeWebviewPanelId == gitardo.flowMerge"
        }
      ],
      "explorer/context": [
        {
          "command": "gitardo.fileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "4_search@90"
        },
        {
          "command": "gitardo.compareWith",
          "when": "resourceScheme == file",
          "group": "4_search@91"
        },
        {
          "command": "gitardo.linkIntoWorktrees",
          "when": "resourceScheme == file && gitardo.hasRepository && explorerResourceIsFolder && resourcePath not in gitardo.linkedIntoWorktrees",
          "group": "z_gitardo_worktrees@1"
        },
        {
          "command": "gitardo.stopLinkingIntoWorktrees",
          "when": "resourceScheme == file && gitardo.hasRepository && resourcePath in gitardo.linkedIntoWorktrees",
          "group": "z_gitardo_worktrees@1"
        },
        {
          "command": "gitardo.copyIntoWorktrees",
          "when": "resourceScheme == file && gitardo.hasRepository && resourcePath not in gitardo.copiedIntoWorktrees",
          "group": "z_gitardo_worktrees@2"
        },
        {
          "command": "gitardo.stopCopyingIntoWorktrees",
          "when": "resourceScheme == file && gitardo.hasRepository && resourcePath in gitardo.copiedIntoWorktrees",
          "group": "z_gitardo_worktrees@2"
        }
      ],
      "editor/context": [
        {
          "command": "gitardo.fileHistory",
          "when": "resourceScheme == file",
          "group": "z_gitardo@1"
        },
        {
          "command": "gitardo.toggleFileBlame",
          "when": "resourceScheme == file && gitardo.hasRepository",
          "group": "z_gitardo@2"
        },
        {
          "command": "gitardo.openLineCommit",
          "when": "resourceScheme == file && gitardo.hasRepository",
          "group": "z_gitardo@3"
        },
        {
          "command": "gitardo.revealLineCommit",
          "when": "resourceScheme == file && gitardo.hasRepository",
          "group": "z_gitardo@4"
        },
        {
          "command": "gitardo.blamePrevious",
          "when": "resourceScheme == file && gitardo.hasRepository",
          "group": "z_gitardo@5"
        }
      ],
      "editor/title/context": [
        {
          "command": "gitardo.fileHistory",
          "when": "resourceScheme == file",
          "group": "z_gitardo@1"
        },
        {
          "command": "gitardo.compareWith",
          "when": "resourceScheme == file",
          "group": "z_gitardo@2"
        }
      ],
      "view/title": [
        {
          "command": "gitardo.refresh",
          "when": "view =~ /^gitardo\\./",
          "group": "navigation@9"
        },
        {
          "command": "gitardo.openInEditor",
          "when": "view == gitardo.graph",
          "group": "navigation@8"
        },
        {
          "command": "gitardo.fetch",
          "when": "view == gitardo.commits || view == gitardo.sideGraph",
          "group": "navigation@1"
        },
        {
          "command": "gitardo.pull",
          "when": "view == gitardo.commits || view == gitardo.sideGraph",
          "group": "navigation@2"
        },
        {
          "command": "gitardo.push",
          "when": "view == gitardo.commits || view == gitardo.sideGraph",
          "group": "navigation@3"
        },
        {
          "command": "gitardo.compare",
          "when": "view == gitardo.sideGraph",
          "group": "navigation@4"
        },
        {
          "command": "gitardo.pullPlain",
          "when": "view == gitardo.commits || view == gitardo.sideGraph",
          "group": "1_sync@1"
        },
        {
          "command": "gitardo.pullRebase",
          "when": "view == gitardo.commits || view == gitardo.sideGraph",
          "group": "1_sync@2"
        },
        {
          "command": "gitardo.pullAutostash",
          "when": "view == gitardo.commits || view == gitardo.sideGraph",
          "group": "1_sync@3"
        },
        {
          "command": "gitardo.pullRebaseAutostash",
          "when": "view == gitardo.commits || view == gitardo.sideGraph",
          "group": "1_sync@4"
        },
        {
          "command": "gitardo.pushForceWithLease",
          "when": "view == gitardo.commits || view == gitardo.sideGraph",
          "group": "1_sync@5"
        },
        {
          "command": "gitardo.pushForce",
          "when": "view == gitardo.commits || view == gitardo.sideGraph",
          "group": "1_sync@6"
        },
        {
          "command": "gitardo.undo",
          "when": "view == gitardo.commits || view == gitardo.sideGraph",
          "group": "2_more@1"
        },
        {
          "command": "gitardo.reflog",
          "when": "view == gitardo.sideGraph",
          "group": "2_more@2"
        },
        {
          "command": "gitardo.goToCommit",
          "when": "view == gitardo.sideGraph",
          "group": "2_more@3"
        },
        {
          "command": "gitardo.createBranch",
          "when": "view == gitardo.branches",
          "group": "navigation@1"
        },
        {
          "command": "gitardo.compare",
          "when": "view == gitardo.branches",
          "group": "navigation@2"
        },
        {
          "command": "gitardo.createWorktree",
          "when": "view == gitardo.branches",
          "group": "0_create@1"
        },
        {
          "command": "gitardo.addSubmodule",
          "when": "view == gitardo.branches",
          "group": "0_create@2"
        },
        {
          "command": "gitardo.switchWorktree",
          "when": "view == gitardo.branches",
          "group": "0_create@2"
        },
        {
          "command": "gitardo.worktreeSetup",
          "when": "view == gitardo.branches",
          "group": "0_create@3"
        },
        {
          "command": "gitardo.cleanupBranches",
          "when": "view == gitardo.branches",
          "group": "1_more@1"
        },
        {
          "command": "gitardo.remotes",
          "when": "view == gitardo.branches",
          "group": "1_more@2"
        },
        {
          "command": "gitardo.stash",
          "when": "view == gitardo.stashes",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "gitardo.showFileBlame",
          "when": "resourceScheme == file && gitardo.hasRepository && !gitardo.fileBlame",
          "group": "navigation@90"
        },
        {
          "command": "gitardo.hideFileBlame",
          "when": "gitardo.fileBlame && resourceScheme =~ /^(file|gitardo)$/",
          "group": "navigation@90"
        },
        {
          "command": "gitardo.blameIgnoreWhitespace",
          "when": "gitardo.fileBlame && resourceScheme =~ /^(file|gitardo)$/ && !config.gitardo.blame.ignoreWhitespaceAndMoves",
          "group": "navigation@91"
        },
        {
          "command": "gitardo.blameCountWhitespace",
          "when": "gitardo.fileBlame && resourceScheme =~ /^(file|gitardo)$/ && config.gitardo.blame.ignoreWhitespaceAndMoves",
          "group": "navigation@91"
        },
        {
          "command": "gitardo.blameEveryFile",
          "when": "gitardo.fileBlame && resourceScheme =~ /^(file|gitardo)$/ && !config.gitardo.fileBlame.everyFile",
          "group": "navigation@92"
        },
        {
          "command": "gitardo.blameChosenFiles",
          "when": "gitardo.fileBlame && resourceScheme =~ /^(file|gitardo)$/ && config.gitardo.fileBlame.everyFile",
          "group": "navigation@92"
        },
        {
          "command": "gitardo.openInFlowDiff",
          "when": "isInDiffEditor && !isInEmbeddedDiffEditor && resourceScheme =~ /^(file|git|gitardo)$/",
          "group": "navigation@80"
        },
        {
          "command": "gitardo.flowDiff.openInDiffEditor",
          "when": "activeWebviewPanelId == gitardo.flowDiff",
          "group": "navigation@0"
        },
        {
          "command": "gitardo.flowDiff.openFile",
          "when": "activeWebviewPanelId == gitardo.flowDiff",
          "group": "navigation@1"
        },
        {
          "command": "gitardo.flowDiff.previousChange",
          "when": "activeWebviewPanelId == gitardo.flowDiff",
          "group": "navigation@2"
        },
        {
          "command": "gitardo.flowDiff.nextChange",
          "when": "activeWebviewPanelId == gitardo.flowDiff",
          "group": "navigation@3"
        },
        {
          "command": "gitardo.flowDiff.stageFile",
          "when": "activeWebviewPanelId == gitardo.flowDiff && gitardo.flowDiffSide == worktree",
          "group": "navigation@4"
        },
        {
          "command": "gitardo.flowDiff.discardFile",
          "when": "activeWebviewPanelId == gitardo.flowDiff && gitardo.flowDiffSide == worktree",
          "group": "navigation@5"
        },
        {
          "command": "gitardo.flowDiff.unstageFile",
          "when": "activeWebviewPanelId == gitardo.flowDiff && gitardo.flowDiffSide == index",
          "group": "navigation@4"
        },
        {
          "command": "gitardo.openInFlowMerge",
          "when": "isMergeEditor",
          "group": "navigation@80"
        },
        {
          "command": "gitardo.flowMerge.openInMergeEditor",
          "when": "activeWebviewPanelId == gitardo.flowMerge",
          "group": "navigation@0"
        },
        {
          "command": "gitardo.flowMerge.openFile",
          "when": "activeWebviewPanelId == gitardo.flowMerge",
          "group": "navigation@1"
        },
        {
          "command": "gitardo.flowMerge.previousChange",
          "when": "activeWebviewPanelId == gitardo.flowMerge",
          "group": "navigation@2"
        },
        {
          "command": "gitardo.flowMerge.nextChange",
          "when": "activeWebviewPanelId == gitardo.flowMerge",
          "group": "navigation@3"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "gitardo.scmStashStaged",
          "when": "scmProvider == git && config.gitardo.scm.stashButtons && scmResourceGroup == index",
          "group": "inline"
        },
        {
          "command": "gitardo.scmStashStaged",
          "when": "scmProvider == git && config.gitardo.scm.stashButtons && scmResourceGroup == index",
          "group": "9_gitardo"
        },
        {
          "command": "gitardo.scmStashAll",
          "when": "scmProvider == git && config.gitardo.scm.stashButtons && scmResourceGroup == workingTree",
          "group": "inline"
        },
        {
          "command": "gitardo.scmStashAll",
          "when": "scmProvider == git && config.gitardo.scm.stashButtons && scmResourceGroup == workingTree",
          "group": "9_gitardo"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "gitardo.scmStashFile",
          "when": "scmProvider == git && config.gitardo.scm.stashButtons && scmResourceGroup =~ /^(index|workingTree|untracked)$/",
          "group": "inline"
        },
        {
          "command": "gitardo.scmStashFile",
          "when": "scmProvider == git && config.gitardo.scm.stashButtons && scmResourceGroup =~ /^(index|workingTree|untracked)$/",
          "group": "9_gitardo"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitardo.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "gitardo.searchFocus"
      },
      {
        "command": "gitardo.openLineCommit",
        "key": "alt+b",
        "mac": "ctrl+alt+b",
        "when": "editorTextFocus && gitardo.hasRepository"
      },
      {
        "command": "gitardo.revealLineCommit",
        "key": "shift+alt+b",
        "mac": "ctrl+shift+alt+b",
        "when": "editorTextFocus && gitardo.hasRepository"
      },
      {
        "command": "gitardo.flowDiff.nextChange",
        "key": "f7",
        "when": "activeWebviewPanelId == gitardo.flowDiff"
      },
      {
        "command": "gitardo.flowDiff.previousChange",
        "key": "shift+f7",
        "when": "activeWebviewPanelId == gitardo.flowDiff"
      },
      {
        "command": "gitardo.flowMerge.nextChange",
        "key": "f7",
        "when": "activeWebviewPanelId == gitardo.flowMerge"
      },
      {
        "command": "gitardo.flowMerge.previousChange",
        "key": "shift+f7",
        "when": "activeWebviewPanelId == gitardo.flowMerge"
      }
    ],
    "configuration": {
      "title": "Gitardo",
      "properties": {
        "gitardo.commandPreview": {
          "type": "string",
          "enum": [
            "off",
            "all"
          ],
          "enumDescriptions": [
            "Only ask before commands that can lose work, such as a force push.",
            "Show the exact Git commands and ask before running anything that changes the repository or a remote."
          ],
          "default": "off",
          "description": "Controls when Gitardo shows the Git commands it is about to run and waits for you to approve them."
        },
        "gitardo.identities": {
          "type": "array",
          "default": [],
          "description": "Names and emails to choose from with Gitardo: Switch Identity. The chosen one is saved in the configuration of the repository.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "email"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Author name, as in user.name."
              },
              "email": {
                "type": "string",
                "description": "Author email, as in user.email."
              },
              "signingKey": {
                "type": "string",
                "description": "Optional key to sign commits with, as in user.signingkey."
              }
            }
          }
        },
        "gitardo.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show who last changed the current line, and when, at the end of that line in the editor."
        },
        "gitardo.blame.ignoreWhitespaceAndMoves": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Leave a line to who wrote it when all that was changed since is its whitespace, or where in the file it is (`git blame -w -M`). It holds for the blame of the line under the cursor and for the blame of a file, and the funnel at the top right of an editor that shows its blame switches it."
        },
        "gitardo.fileBlame.everyFile": {
          "type": "boolean",
          "default": false,
          "description": "Show the blame of a file beside its lines in every file that is opened, rather than in the ones it is asked for. The pin at the top right of an editor that shows its blame switches it, and the button of the blame still hides it file by file."
        },
        "gitardo.fileBlame.format": {
          "type": "string",
          "default": "${date} ${author:20}",
          "markdownDescription": "What the blame of a file says beside each line. `${date}` is the day of the commit, `${ago}` how long ago it was, `${author}` who made it, `${summary}` the first line of its message, and `${hash}` its hash. A number after a colon is the most letters something may take, as in `${author:20}`; a hash is 7 letters unless told otherwise. Anything else is written as it is. Example: `${ago} ${author:16} ${summary:40}`."
        },
        "gitardo.fileBlame.groupLines": {
          "type": "boolean",
          "default": true,
          "description": "In the blame of a file, say the commit beside the first of the lines it changed that follow each other, and leave the others with nothing but its colors; when that line is scrolled out of sight, the first line in sight says it. Turn it off to have it said beside every line."
        },
        "gitardo.fileBlame.age.enabled": {
          "type": "boolean",
          "default": true,
          "description": "In the blame of a file, draw a line beside each line of the file in a color that says how long ago it was changed."
        },
        "gitardo.fileBlame.age.recentColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#e5534b",
          "markdownDescription": "The color of the age of a line that was just changed, as `#rrggbb`."
        },
        "gitardo.fileBlame.age.oldColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#316dca",
          "markdownDescription": "The color of the age of a line that was changed long ago, as `#rrggbb`. The ages in between have the colors in between."
        },
        "gitardo.fileBlame.age.oldAfterDays": {
          "type": "number",
          "default": 730,
          "minimum": 1,
          "description": "After how many days a line has the color of the lines changed long ago. Recent days count more than old ones: a day and a week are further apart than a year and a year and a week."
        },
        "gitardo.changes.openOnClick": {
          "type": "string",
          "enum": [
            "file",
            "diff"
          ],
          "enumDescriptions": [
            "Open the file, as it is on disk. A deleted file opens its diff.",
            "Open the diff of the file against the last commit, what is staged and what is not together."
          ],
          "default": "file",
          "markdownDescription": "What a click on a file of the Gitardo Changes view opens. The buttons on its row open either one, whatever is set here. The list of changes of VS Code, in the Source Control view, is not affected."
        },
        "gitardo.scm.stashButtons": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Add the buttons that stash to the list of changes of VS Code, in the Source Control view: on each file, on **Staged Changes** for what is staged, and on **Changes** for everything. The Changes view of Gitardo has them whatever is set here."
        },
        "gitardo.pull.autostash": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Whether the **Pull** button sets the changes that are not committed aside before it pulls, and puts them back after: `git pull --autostash`. Switched off, a pull that would touch a file with changes is refused by Git. The menu beside the button has every way to pull, whatever is set here."
        },
        "gitardo.submodules.updateOnCheckout": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Whether checking out a branch, a tag or a commit with Gitardo also checks out in each submodule the commit recorded for it there, cloning the ones that are new: `git submodule update --init --recursive`, run after the checkout when the repository has submodules, before or after it. Switched off, the submodules stay on what they had, and the Submodules section says how far that is from what is recorded."
        },
        "gitardo.pull.rebase": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Whether the **Pull** button puts your commits that are not pushed on top of what comes in, instead of merging the two: `git pull --rebase`. With `#gitardo.pull.autostash#` it runs `git pull --rebase --autostash`. Switched off, the button leaves the choice to the configuration of Git, which merges unless told otherwise. The menu beside the button has every way to pull, whatever is set here."
        },
        "gitardo.branches.openIn": {
          "type": "string",
          "enum": [
            "checkout",
            "worktree"
          ],
          "enumDescriptions": [
            "Check the branch out in this window.",
            "Open the worktree of the branch, made for it first, named after it, when it has none. This window stays on its branch."
          ],
          "default": "checkout",
          "description": "What a double click on a local branch does. A branch that another worktree has always opens that worktree, and the context menu of a branch has both, whatever is set here."
        },
        "gitardo.graph.pageSize": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 10000,
          "markdownDescription": "How many commits the graph reads at a time. The next ones are read while you scroll, long before you get to the end of those shown. Fewer make each read quicker, on a slow machine or in a very large repository; more make the reads fewer."
        },
        "gitardo.graph.showStashes": {
          "type": "boolean",
          "default": true,
          "description": "Whether the graph shows the stashes, each above the commit it was made on, while that commit is in the graph. The menu of the toolbar of the graph has the same switch."
        },
        "gitardo.graph.firstParent": {
          "type": "boolean",
          "default": false,
          "description": "Whether the graph follows only the first parent of each merge: the line of the branch that was merged into, without the commits that came with the merge. The menu of the toolbar of the graph has the same switch."
        },
        "gitardo.graph.traceSelected": {
          "type": "boolean",
          "default": true,
          "description": "Whether the history of the commit selected in the graph stands out, the commits it comes from and the ones made on top of it, while the rest is dimmed. The menu of the toolbar of the graph has the same switch."
        },
        "gitardo.branches.followGraphFilter": {
          "type": "boolean",
          "default": true,
          "description": "Whether the branches, remote branches and tags listed beside the graph and in the Branches view are only the ones the graph is narrowed to. Switched off, they are all listed, and the ones the graph leaves out are dimmed. The list of branches of the graph has the same switch."
        },
        "gitardo.branches.format": {
          "type": "string",
          "default": "",
          "markdownDescription": "A format for the names of the branches that **Create Branch** and **Create Worktree** make, such as `PRJ-${input:ticket}-${input:kind}-rfi-${base}`. `${input:<id>}` is asked for as `#gitardo.branches.inputs#` says, `${base}` is the branch it starts from without its remote, `${repo}` the name of the folder of the repository and `${date}` today, as `2026-10-15`. The name it makes can still be changed before the branch is created, and a branch name can be typed instead. Empty, the name is typed."
        },
        "gitardo.branches.inputs": {
          "type": "array",
          "default": [],
          "markdownDescription": "What `${input:<id>}` in `#gitardo.branches.format#` asks for: a text typed (`promptString`), or a value picked from `options` (`pickString`), which can also be typed when `allowCustom` is true. The value used last is proposed the next time.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "The name used in the format, as in ${input:ticket}."
              },
              "type": {
                "type": "string",
                "enum": [
                  "promptString",
                  "pickString"
                ],
                "enumDescriptions": [
                  "A text typed.",
                  "A value picked from the options."
                ]
              },
              "description": {
                "type": "string",
                "description": "What is asked, as the prompt says it."
              },
              "default": {
                "type": "string",
                "description": "The value proposed before any was used."
              },
              "pattern": {
                "type": "string",
                "description": "A regular expression that a typed value must match, such as ^\\d+$ for a number."
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The values to pick from, for pickString."
              },
              "allowCustom": {
                "type": "boolean",
                "default": false,
                "description": "Whether a value that is not among the options can be typed, for pickString."
              }
            }
          }
        },
        "gitardo.worktrees.openIn": {
          "type": "string",
          "enum": [
            "window",
            "agents"
          ],
          "enumDescriptions": [
            "A new VS Code window, with the worktree as its folder.",
            "The Agents window of VS Code, for agent sessions that work in the worktree. Where VS Code has no Agents window, a new window."
          ],
          "default": "window",
          "description": "Where a worktree opens on a double click, on it or on its branch, and by Open in worktree and Switch Worktree. The context menus of worktrees and their branches have both, whatever is set here."
        },
        "gitardo.worktrees.folder": {
          "type": "string",
          "default": "${repo}.worktrees",
          "markdownDescription": "Where **Create Worktree** puts new worktrees, each in a folder named after it. `${repo}` is the name of the folder of the repository, and a relative path starts from the folder that holds it: with the default, the worktree `fix-login` of `~/code/app` goes in `~/code/app.worktrees/fix-login`."
        },
        "gitardo.worktrees.linkFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Folders that git ignores to link into each new worktree from the folder it is created from, in `.gitignore` syntax, such as `node_modules/`: what changes through a link changes there too. On Windows the links are junctions, which Gitardo takes out before removing a worktree. Set here, even empty, it takes the place of VS Code's `#git.worktreeSymlinkFolders#` for the worktrees Gitardo creates. [Choose what new worktrees get](command:gitardo.worktreeSetup), from what git ignores now."
        },
        "gitardo.worktrees.copyFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Files and folders that git ignores to copy into each new worktree from the folder it is created from, in `.gitignore` syntax, such as `/.env`. What is inside a linked folder, and what the worktree has from its commit, is not copied. Set here, even empty, it takes the place of VS Code's `#git.worktreeIncludeFiles#` for the worktrees Gitardo creates. [Choose what new worktrees get](command:gitardo.worktreeSetup), from what git ignores now."
        },
        "gitardo.worktrees.branchFormat": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Now `#gitardo.branches.format#`, for every new branch. Set here, it is still used where that is not set."
        },
        "gitardo.worktrees.inputs": {
          "type": "array",
          "default": [],
          "markdownDeprecationMessage": "Now `#gitardo.branches.inputs#`. Set here, it is still used where that is not set."
        },
        "gitardo.conflicts.autoResolve": {
          "type": "boolean",
          "default": false,
          "tags": [
            "experimental"
          ],
          "markdownDescription": "Offer to resolve automatically the conflicts that need no choice between the two sides: changes to lines next to each other, the same change made twice, changes that differ only in whitespace. Gitardo shows each resolution first, in a tab where they are accepted all at once or one by one, and the conflicts can be restored with **Undo**. This is still being tested: look at what it wrote before you commit."
        },
        "gitardo.conflicts.ai": {
          "type": "boolean",
          "default": false,
          "tags": [
            "experimental"
          ],
          "markdownDescription": "Offer to ask the language model you use in VS Code, such as GitHub Copilot, how to resolve the conflicts that `#gitardo.conflicts.autoResolve#` leaves. Gitardo sends each conflict and the lines around it to the model, and shows what it proposes in the tab of the review, where nothing is written until you accept it. A model can write lines that neither side has: look at each resolution before you accept it."
        },
        "gitardo.conflicts.aiModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "The id of the language model that `#gitardo.conflicts.ai#` asks, as **Gitardo: Choose the Model That Resolves Conflicts** writes it. Empty for the first model VS Code has."
        },
        "gitardo.conflicts.aiEffort": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumItemLabels": [
            "As the model is set up",
            "Low",
            "Medium",
            "High",
            "Extra high",
            "Max"
          ],
          "markdownDescription": "How much the model of `#gitardo.conflicts.aiModel#` thinks before it answers. Empty leaves it as the model is set up in VS Code; a model without such a setting ignores it."
        },
        "gitardo.flowDiff.collapseUnchanged": {
          "type": "boolean",
          "default": true,
          "description": "Whether the Flow Diff folds long runs of unchanged lines, keeping 3 lines around each change. Its toolbar switches it for each diff."
        }
      }
    },
    "colors": [
      {
        "id": "gitardo.blameHighlightBackground",
        "description": "Background of the blame beside the line under the cursor, and beside the other lines of the same commit.",
        "defaults": {
          "dark": "#2f81f740",
          "light": "#0969da26",
          "highContrast": "#2f81f766",
          "highContrastLight": "#0969da40"
        }
      },
      {
        "id": "gitardo.blameHighlightForeground",
        "description": "Color of the blame beside the line under the cursor and the other lines of the same commit, and of their marks in the scroll bar.",
        "defaults": {
          "dark": "#79b8ff",
          "light": "#0550ae",
          "highContrast": "#79b8ff",
          "highContrastLight": "#0550ae"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node esbuild.mjs && node test/e2e/run.mjs",
    "test:ui": "node esbuild.mjs && node test/e2e/ui.mjs",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "test:vsix": "npm run package && node test/e2e/run.mjs --vsix",
    "preview": "node dist/dev-server.js"
  },
  "devDependencies": {
    "@shikijs/engine-javascript": "^4.2.0",
    "@shikijs/langs": "^4.2.0",
    "@shikijs/monaco": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "@types/diff": "^7.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.100.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^4.0.0",
    "diff": "^7.0.0",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.55.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
