{
  "name": "gitar",
  "displayName": "Gitar",
  "description": "Commit graph, history and everyday Git operations in a single panel.",
  "version": "0.1.0",
  "publisher": "RiccardoFilippozzi",
  "repository": "https://github.com/riccardoflp/gitar",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "gitar",
          "title": "Gitar",
          "icon": "media/gitar.svg"
        }
      ]
    },
    "views": {
      "gitar": [
        {
          "type": "webview",
          "id": "gitar.graph",
          "name": "Graph"
        }
      ],
      "scm": [
        {
          "type": "webview",
          "id": "gitar.changes",
          "name": "Gitar Changes",
          "contextualTitle": "Gitar",
          "visibility": "hidden",
          "initialSize": 5
        },
        {
          "type": "webview",
          "id": "gitar.commits",
          "name": "Commits",
          "contextualTitle": "Gitar",
          "initialSize": 4
        },
        {
          "type": "webview",
          "id": "gitar.sideGraph",
          "name": "Gitar Graph",
          "contextualTitle": "Gitar",
          "visibility": "collapsed",
          "initialSize": 4
        },
        {
          "type": "webview",
          "id": "gitar.branches",
          "name": "Branches",
          "contextualTitle": "Gitar",
          "initialSize": 3
        },
        {
          "type": "webview",
          "id": "gitar.stashes",
          "name": "Stashes",
          "contextualTitle": "Gitar",
          "visibility": "collapsed",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "gitar.openGraph",
        "title": "Show Graph",
        "category": "Gitar"
      },
      {
        "command": "gitar.openInEditor",
        "title": "Open Graph in Editor",
        "category": "Gitar",
        "icon": "$(link-external)"
      },
      {
        "command": "gitar.refresh",
        "title": "Refresh",
        "category": "Gitar",
        "icon": "$(refresh)"
      },
      {
        "command": "gitar.fetch",
        "title": "Fetch",
        "category": "Gitar",
        "icon": "$(repo-fetch)"
      },
      {
        "command": "gitar.pull",
        "title": "Pull",
        "category": "Gitar",
        "icon": "$(repo-pull)"
      },
      {
        "command": "gitar.pullPlain",
        "title": "Pull (No Options)",
        "category": "Gitar"
      },
      {
        "command": "gitar.pullRebase",
        "title": "Pull (Rebase)",
        "category": "Gitar"
      },
      {
        "command": "gitar.pullAutostash",
        "title": "Pull (Autostash)",
        "category": "Gitar"
      },
      {
        "command": "gitar.pullRebaseAutostash",
        "title": "Pull (Rebase, Autostash)",
        "category": "Gitar"
      },
      {
        "command": "gitar.push",
        "title": "Push",
        "category": "Gitar",
        "icon": "$(repo-push)"
      },
      {
        "command": "gitar.pushForceWithLease",
        "title": "Push (Force with Lease)",
        "category": "Gitar"
      },
      {
        "command": "gitar.pushForce",
        "title": "Push (Force)",
        "category": "Gitar"
      },
      {
        "command": "gitar.showLog",
        "title": "Show Command Log",
        "category": "Gitar"
      },
      {
        "command": "gitar.openChanges",
        "title": "Show Changes",
        "category": "Gitar"
      },
      {
        "command": "gitar.stash",
        "title": "Stash Changes",
        "category": "Gitar",
        "icon": "$(git-stash)"
      },
      {
        "command": "gitar.undo",
        "title": "Undo Last Operation",
        "category": "Gitar"
      },
      {
        "command": "gitar.fileHistory",
        "title": "Show File History",
        "category": "Gitar"
      },
      {
        "command": "gitar.revealCommit",
        "title": "Show Commit in Graph",
        "category": "Gitar"
      },
      {
        "command": "gitar.reflog",
        "title": "Browse Reflog",
        "category": "Gitar"
      },
      {
        "command": "gitar.cleanupBranches",
        "title": "Clean Up Branches",
        "category": "Gitar"
      },
      {
        "command": "gitar.signInGitHub",
        "title": "Sign In to GitHub",
        "category": "Gitar"
      },
      {
        "command": "gitar.toggleBlame",
        "title": "Toggle Inline Blame",
        "category": "Gitar"
      },
      {
        "command": "gitar.toggleFileBlame",
        "title": "Toggle File Blame",
        "category": "Gitar"
      },
      {
        "command": "gitar.showFileBlame",
        "title": "Show File Blame",
        "category": "Gitar",
        "icon": "$(person)"
      },
      {
        "command": "gitar.hideFileBlame",
        "title": "Hide File Blame",
        "category": "Gitar",
        "icon": "$(eye-closed)"
      },
      {
        "command": "gitar.toggleBlameEveryFile",
        "title": "Toggle File Blame in Every File",
        "category": "Gitar"
      },
      {
        "command": "gitar.blameEveryFile",
        "title": "Keep File Blame On in Every File",
        "category": "Gitar",
        "icon": "$(pin)"
      },
      {
        "command": "gitar.blameChosenFiles",
        "title": "Stop Keeping File Blame On in Every File",
        "category": "Gitar",
        "icon": "$(pinned)"
      },
      {
        "command": "gitar.toggleBlameWhitespace",
        "title": "Toggle Ignoring Whitespace and Moved Lines in Blame",
        "category": "Gitar"
      },
      {
        "command": "gitar.blameIgnoreWhitespace",
        "title": "Ignore Whitespace and Moved Lines in Blame",
        "category": "Gitar",
        "icon": "$(filter)"
      },
      {
        "command": "gitar.blameCountWhitespace",
        "title": "Stop Ignoring Whitespace and Moved Lines in Blame",
        "category": "Gitar",
        "icon": "$(filter-filled)"
      },
      {
        "command": "gitar.openLineCommit",
        "title": "Open Commit of Current Line in Editor",
        "category": "Gitar"
      },
      {
        "command": "gitar.revealLineCommit",
        "title": "Reveal Commit of Current Line in Graph",
        "category": "Gitar"
      },
      {
        "command": "gitar.blamePrevious",
        "title": "Blame File Before Commit of Current Line",
        "category": "Gitar"
      },
      {
        "command": "gitar.switchIdentity",
        "title": "Switch Identity",
        "category": "Gitar"
      },
      {
        "command": "gitar.selectRepository",
        "title": "Select Repository",
        "category": "Gitar"
      },
      {
        "command": "gitar.remotes",
        "title": "Manage Remotes",
        "category": "Gitar"
      },
      {
        "command": "gitar.bisectReset",
        "title": "End Bisect",
        "category": "Gitar"
      },
      {
        "command": "gitar.compare",
        "title": "Compare Branches, Tags or Commits…",
        "category": "Gitar",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitar.goToCommit",
        "title": "Go to Commit…",
        "category": "Gitar"
      },
      {
        "command": "gitar.openCommit",
        "title": "Open Commit in Editor…",
        "category": "Gitar"
      },
      {
        "command": "gitar.resolveConflicts",
        "title": "Resolve Conflicts Automatically",
        "category": "Gitar",
        "icon": "$(wand)"
      },
      {
        "command": "gitar.createBranch",
        "title": "Create Branch…",
        "category": "Gitar",
        "icon": "$(add)"
      },
      {
        "command": "gitar.openCommits",
        "title": "Show Commits in the Side Bar",
        "category": "Gitar"
      },
      {
        "command": "gitar.openSideGraph",
        "title": "Open Graph in the Side Bar",
        "category": "Gitar"
      },
      {
        "command": "gitar.openBranches",
        "title": "Show Branches",
        "category": "Gitar"
      },
      {
        "command": "gitar.openStashes",
        "title": "Show Stashes",
        "category": "Gitar"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitar.revealCommit",
          "when": "false"
        },
        {
          "command": "gitar.resolveConflicts",
          "when": "config.gitar.conflicts.autoResolve"
        },
        {
          "command": "gitar.showFileBlame",
          "when": "false"
        },
        {
          "command": "gitar.hideFileBlame",
          "when": "false"
        },
        {
          "command": "gitar.blameEveryFile",
          "when": "false"
        },
        {
          "command": "gitar.blameChosenFiles",
          "when": "false"
        },
        {
          "command": "gitar.blameIgnoreWhitespace",
          "when": "false"
        },
        {
          "command": "gitar.blameCountWhitespace",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "gitar.fileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "4_search@90"
        }
      ],
      "editor/context": [
        {
          "command": "gitar.fileHistory",
          "when": "resourceScheme == file",
          "group": "z_gitar@1"
        },
        {
          "command": "gitar.toggleFileBlame",
          "when": "resourceScheme == file && gitar.hasRepository",
          "group": "z_gitar@2"
        },
        {
          "command": "gitar.openLineCommit",
          "when": "resourceScheme == file && gitar.hasRepository",
          "group": "z_gitar@3"
        },
        {
          "command": "gitar.revealLineCommit",
          "when": "resourceScheme == file && gitar.hasRepository",
          "group": "z_gitar@4"
        },
        {
          "command": "gitar.blamePrevious",
          "when": "resourceScheme == file && gitar.hasRepository",
          "group": "z_gitar@5"
        }
      ],
      "editor/title/context": [
        {
          "command": "gitar.fileHistory",
          "when": "resourceScheme == file",
          "group": "z_gitar@1"
        }
      ],
      "view/title": [
        {
          "command": "gitar.refresh",
          "when": "view =~ /^gitar\\./",
          "group": "navigation@9"
        },
        {
          "command": "gitar.openInEditor",
          "when": "view == gitar.graph",
          "group": "navigation@8"
        },
        {
          "command": "gitar.fetch",
          "when": "view == gitar.commits || view == gitar.sideGraph",
          "group": "navigation@1"
        },
        {
          "command": "gitar.pull",
          "when": "view == gitar.commits || view == gitar.sideGraph",
          "group": "navigation@2"
        },
        {
          "command": "gitar.push",
          "when": "view == gitar.commits || view == gitar.sideGraph",
          "group": "navigation@3"
        },
        {
          "command": "gitar.compare",
          "when": "view == gitar.sideGraph",
          "group": "navigation@4"
        },
        {
          "command": "gitar.pullPlain",
          "when": "view == gitar.commits || view == gitar.sideGraph",
          "group": "1_sync@1"
        },
        {
          "command": "gitar.pullRebase",
          "when": "view == gitar.commits || view == gitar.sideGraph",
          "group": "1_sync@2"
        },
        {
          "command": "gitar.pullAutostash",
          "when": "view == gitar.commits || view == gitar.sideGraph",
          "group": "1_sync@3"
        },
        {
          "command": "gitar.pullRebaseAutostash",
          "when": "view == gitar.commits || view == gitar.sideGraph",
          "group": "1_sync@4"
        },
        {
          "command": "gitar.pushForceWithLease",
          "when": "view == gitar.commits || view == gitar.sideGraph",
          "group": "1_sync@5"
        },
        {
          "command": "gitar.pushForce",
          "when": "view == gitar.commits || view == gitar.sideGraph",
          "group": "1_sync@6"
        },
        {
          "command": "gitar.undo",
          "when": "view == gitar.commits || view == gitar.sideGraph",
          "group": "2_more@1"
        },
        {
          "command": "gitar.reflog",
          "when": "view == gitar.sideGraph",
          "group": "2_more@2"
        },
        {
          "command": "gitar.goToCommit",
          "when": "view == gitar.sideGraph",
          "group": "2_more@3"
        },
        {
          "command": "gitar.createBranch",
          "when": "view == gitar.branches",
          "group": "navigation@1"
        },
        {
          "command": "gitar.compare",
          "when": "view == gitar.branches",
          "group": "navigation@2"
        },
        {
          "command": "gitar.cleanupBranches",
          "when": "view == gitar.branches",
          "group": "1_more@1"
        },
        {
          "command": "gitar.remotes",
          "when": "view == gitar.branches",
          "group": "1_more@2"
        },
        {
          "command": "gitar.stash",
          "when": "view == gitar.stashes",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "gitar.showFileBlame",
          "when": "resourceScheme == file && gitar.hasRepository && !gitar.fileBlame",
          "group": "navigation@90"
        },
        {
          "command": "gitar.hideFileBlame",
          "when": "gitar.fileBlame && resourceScheme =~ /^(file|gitar)$/",
          "group": "navigation@90"
        },
        {
          "command": "gitar.blameIgnoreWhitespace",
          "when": "gitar.fileBlame && resourceScheme =~ /^(file|gitar)$/ && !config.gitar.blame.ignoreWhitespaceAndMoves",
          "group": "navigation@91"
        },
        {
          "command": "gitar.blameCountWhitespace",
          "when": "gitar.fileBlame && resourceScheme =~ /^(file|gitar)$/ && config.gitar.blame.ignoreWhitespaceAndMoves",
          "group": "navigation@91"
        },
        {
          "command": "gitar.blameEveryFile",
          "when": "gitar.fileBlame && resourceScheme =~ /^(file|gitar)$/ && !config.gitar.fileBlame.everyFile",
          "group": "navigation@92"
        },
        {
          "command": "gitar.blameChosenFiles",
          "when": "gitar.fileBlame && resourceScheme =~ /^(file|gitar)$/ && config.gitar.fileBlame.everyFile",
          "group": "navigation@92"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitar.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "gitar.searchFocus"
      },
      {
        "command": "gitar.openLineCommit",
        "key": "alt+b",
        "mac": "ctrl+alt+b",
        "when": "editorTextFocus && gitar.hasRepository"
      },
      {
        "command": "gitar.revealLineCommit",
        "key": "shift+alt+b",
        "mac": "ctrl+shift+alt+b",
        "when": "editorTextFocus && gitar.hasRepository"
      }
    ],
    "configuration": {
      "title": "Gitar",
      "properties": {
        "gitar.commandPreview": {
          "type": "string",
          "enum": [
            "off",
            "all"
          ],
          "enumDescriptions": [
            "Only ask before commands that can lose work, such as a force push.",
            "Show the exact Git commands and ask before running anything that changes the repository or a remote."
          ],
          "default": "off",
          "description": "Controls when Gitar shows the Git commands it is about to run and waits for you to approve them."
        },
        "gitar.identities": {
          "type": "array",
          "default": [],
          "description": "Names and emails to choose from with Gitar: Switch Identity. The chosen one is saved in the configuration of the repository.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "email"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Author name, as in user.name."
              },
              "email": {
                "type": "string",
                "description": "Author email, as in user.email."
              },
              "signingKey": {
                "type": "string",
                "description": "Optional key to sign commits with, as in user.signingkey."
              }
            }
          }
        },
        "gitar.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show who last changed the current line, and when, at the end of that line in the editor."
        },
        "gitar.blame.ignoreWhitespaceAndMoves": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Leave a line to who wrote it when all that was changed since is its whitespace, or where in the file it is (`git blame -w -M`). It holds for the blame of the line under the cursor and for the blame of a file, and the funnel at the top right of an editor that shows its blame switches it."
        },
        "gitar.fileBlame.everyFile": {
          "type": "boolean",
          "default": false,
          "description": "Show the blame of a file beside its lines in every file that is opened, rather than in the ones it is asked for. The pin at the top right of an editor that shows its blame switches it, and the button of the blame still hides it file by file."
        },
        "gitar.fileBlame.format": {
          "type": "string",
          "default": "${date} ${author:20}",
          "markdownDescription": "What the blame of a file says beside each line. `${date}` is the day of the commit, `${ago}` how long ago it was, `${author}` who made it, `${summary}` the first line of its message, and `${hash}` its hash. A number after a colon is the most letters something may take, as in `${author:20}`; a hash is 7 letters unless told otherwise. Anything else is written as it is. Example: `${ago} ${author:16} ${summary:40}`."
        },
        "gitar.fileBlame.groupLines": {
          "type": "boolean",
          "default": true,
          "description": "In the blame of a file, say the commit beside the first of the lines it changed that follow each other, and leave the others with nothing but its colors. Turn it off to have it said beside every line."
        },
        "gitar.fileBlame.age.enabled": {
          "type": "boolean",
          "default": true,
          "description": "In the blame of a file, draw a line beside each line of the file in a color that says how long ago it was changed."
        },
        "gitar.fileBlame.age.recentColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#e5534b",
          "markdownDescription": "The color of the age of a line that was just changed, as `#rrggbb`."
        },
        "gitar.fileBlame.age.oldColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#316dca",
          "markdownDescription": "The color of the age of a line that was changed long ago, as `#rrggbb`. The ages in between have the colors in between."
        },
        "gitar.fileBlame.age.oldAfterDays": {
          "type": "number",
          "default": 730,
          "minimum": 1,
          "description": "After how many days a line has the color of the lines changed long ago. Recent days count more than old ones: a day and a week are further apart than a year and a year and a week."
        },
        "gitar.pull.autostash": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Whether the **Pull** button sets the changes that are not committed aside before it pulls, and puts them back after: `git pull --autostash`. Switched off, a pull that would touch a file with changes is refused by Git. The menu beside the button has every way to pull, whatever is set here."
        },
        "gitar.pull.rebase": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Whether the **Pull** button puts your commits that are not pushed on top of what comes in, instead of merging the two: `git pull --rebase`. With `#gitar.pull.autostash#` it runs `git pull --rebase --autostash`. Switched off, the button leaves the choice to the configuration of Git, which merges unless told otherwise. The menu beside the button has every way to pull, whatever is set here."
        },
        "gitar.conflicts.autoResolve": {
          "type": "boolean",
          "default": false,
          "tags": [
            "experimental"
          ],
          "markdownDescription": "Offer to resolve automatically the conflicts that need no choice between the two sides: changes to lines next to each other, the same change made twice, changes that differ only in whitespace. Gitar shows what it would write before writing it, and the conflicts can be restored with **Undo**. This is still being tested: look at what it wrote before you commit."
        }
      }
    },
    "colors": [
      {
        "id": "gitar.blameHighlightBackground",
        "description": "Background of the blame beside the line under the cursor, and beside the other lines of the same commit.",
        "defaults": {
          "dark": "#2f81f740",
          "light": "#0969da26",
          "highContrast": "#2f81f766",
          "highContrastLight": "#0969da40"
        }
      },
      {
        "id": "gitar.blameHighlightForeground",
        "description": "Color of the blame beside the line under the cursor and the other lines of the same commit, and of their marks in the scroll bar.",
        "defaults": {
          "dark": "#79b8ff",
          "light": "#0550ae",
          "highContrast": "#79b8ff",
          "highContrastLight": "#0550ae"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node esbuild.mjs && node test/e2e/run.mjs",
    "test:ui": "node esbuild.mjs && node test/e2e/ui.mjs",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "test:vsix": "npm run package && node test/e2e/run.mjs --vsix",
    "preview": "node dist/dev-server.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.100.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
